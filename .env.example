# Copiar a `.env` para desarrollo local:  cp .env.example .env
# `.env` NO se sube a git.

# --- Infraestructura (docker-compose.yml) ---
POSTGRES_USER=dad
POSTGRES_PASSWORD=dad_dev
POSTGRES_DB=dad_copropiedad
POSTGRES_PORT=5432
# Contraseña del rol restringido de la aplicación (sin BYPASSRLS)
APP_DB_PASSWORD=dad_app_dev

# --- Base de datos ---
# Dueño del esquema: migraciones, `sqlx-cli`, `query!` en compilación y `#[sqlx::test]`.
DATABASE_URL=postgres://dad:dad_dev@localhost:5432/dad_copropiedad
# Rol con el que corren `api` y `gateway`. RLS solo aísla tenants con este rol.
APP_DATABASE_URL=postgres://dad_app:dad_app_dev@localhost:5432/dad_copropiedad
DATABASE_MAX_CONNECTIONS=10
# Solo en desarrollo: `api` aplica migraciones al arrancar (con DATABASE_URL). En producción aparte.
RUN_MIGRATIONS=true

# --- Servicios ---
APP_HOST=0.0.0.0
APP_PORT=8080
GATEWAY_PORT=8081
REQUEST_TIMEOUT_SECS=30
# Documentación interactiva de la API en /docs y contrato en /api-docs/openapi.json.
# true solo en desarrollo; en producción false (o detrás de autenticación).
API_DOCS_HABILITADA=true

# Orígenes de la web en OTRO dominio que pueden llamar la API desde el navegador (CORS), separados
# por comas: https://app.dominio.co (http solo para localhost). Vacío = sin CORS (la web debe
# servirse en el mismo dominio que la API). Las apps de Flutter no lo necesitan.
CORS_ORIGENES=http://localhost:5173

# --- Correo saliente (worker del gateway) ---
# Desarrollo: Mailpit (docker compose) atrapa los correos; bandeja en http://localhost:8025.
# Producción: SMTP de HestiaCP, p. ej. SMTP_HOST=mail.dominio.co, SMTP_PUERTO=587,
# SMTP_SEGURIDAD=starttls y usuario/contraseña del buzón. Sin SMTP_HOST el envío queda desactivado.
SMTP_HOST=localhost
SMTP_PUERTO=1025
# starttls (587, recomendado) | tls (465) | ninguna (solo desarrollo)
SMTP_SEGURIDAD=ninguna
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE="DAD Copropiedad <no-responder@localhost.dev>"
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# --- Archivos y adjuntos (api) — ADR 0003 ---
# Almacén: `local` (disco del servidor). `s3` está previsto; cambiarlo exige migrar antes.
ARCHIVOS_ALMACEN=local
# Raíz del almacén local. En producción, un directorio fuera del código e incluido en la copia
# de seguridad del VPS (p. ej. /var/lib/dad_copropiedad/archivos).
ARCHIVOS_DIR=./datos/archivos
# Secreto HMAC de los enlaces de descarga (mínimo 32 caracteres). En producción: `openssl rand -hex 32`.
ARCHIVOS_SECRETO_ENLACES=desarrollo-cambiar-este-secreto-de-32-caracteres
# URL pública de la API con la que se arman los enlaces de descarga.
ARCHIVOS_URL_PUBLICA=http://localhost:8080

# --- Límite de peticiones por IP (plan 09) ---
# Registro, inicio de sesión, segundo factor y recuperar contraseña, por minuto y por IP.
LIMITE_AUTH_POR_MINUTO=10
# Papeleta virtual, puentes de acceso y descarga con enlace, por minuto y por IP.
LIMITE_PUBLICO_POR_MINUTO=120
# Detrás de Nginx: tomar la IP real de `X-Real-IP` (Nginx debe fijarla). Nunca `true` si la API
# está expuesta directamente: el cliente podría falsear su IP.
CONFIAR_PROXY=false

# --- Control de acceso (plan 05, ADR 0011) ---
# Secreto maestro de los QR temporales de visitas (mínimo 32 caracteres; obligatorio para la API y
# el gateway, que firma los QR que se piden por el chat de WhatsApp).
# De él se deriva la clave Ed25519 de cada PH. Rotarlo invalida los QR emitidos.
# En producción: `openssl rand -hex 32`.
ACCESO_QR_SECRETO=desarrollo-cambiar-este-secreto-de-los-qr-32
# Notificaciones push de las apps Flutter (Firebase Cloud Messaging HTTP v1). Ruta del JSON de la
# cuenta de servicio de Firebase (Consola → Configuración del proyecto → Cuentas de servicio).
# Vacío = el gateway no envía push y los avisos de portería salen por WhatsApp.
FCM_CREDENCIALES=
# Base de la API de FCM (solo se cambia en pruebas).
# FCM_API_URL=https://fcm.googleapis.com

# --- Puente de acceso en sitio (`cargo puente`; corre en el mini PC de la PH, no en el VPS) ---
# Raíz de la API con versión y token de máquina que devuelve POST /copropiedades/{id}/puentes.
# PUENTE_API_URL=http://localhost:8080/api/v1
# PUENTE_TOKEN=
# Cache local y cola de eventos (deben sobrevivir reinicios del equipo).
# PUENTE_DATOS_DIR=./datos/puente
# Zona horaria de la PH para evaluar horarios sin internet.
# PUENTE_ZONA_HORARIA=America/Bogota
# Segundos entre sincronizaciones (una credencial revocada sale de la cache en menos de un minuto).
# PUENTE_INTERVALO_SEGUNDOS=20

# --- Seguridad de cuentas (api) ---
# Operar la plataforma (/api/v1/plataforma) exige segundo factor (TOTP). En producción SIEMPRE
# true (es el valor por defecto si no se define). Solo en desarrollo puede ser false.
PLATAFORMA_EXIGE_SEGUNDO_FACTOR=false

# --- WhatsApp Cloud API (gateway) ---
WHATSAPP_VERIFY_TOKEN=cambiar-token-de-verificacion
WHATSAPP_APP_SECRET=cambiar-app-secret
# Token de acceso de un usuario del sistema de Meta para ENVIAR (chat, avisos de tickets). Si se
# deja vacío, el gateway recibe mensajes pero no envía por WhatsApp (quedan pendientes).
WHATSAPP_ACCESS_TOKEN=
# Graph API con versión fija. Cambiarla solo tras revisar las notas de la versión de Meta.
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
# El gateway guarda las fotos que llegan por WhatsApp con las mismas variables ARCHIVOS_* de la API.

# --- Logs ---
# pretty (desarrollo) | json (producción)
LOG_FORMAT=pretty
RUST_LOG=info,dad_copropiedad_api=debug,dad_copropiedad_gateway=debug,domain=debug,application=debug,infra_postgres=debug,infra_whatsapp=debug,infra_correo=debug,tower_http=info,sqlx=warn

# --- Producción: rendimiento (solo docker-compose.prod.yml; tabla por RAM en docs/despliegue.md §9) ---
# Valores por defecto para un VPS de 4 GB compartido con HestiaCP.
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=128MB
# Debe cubrir API_DB_CONEXIONES + GATEWAY_DB_CONEXIONES + margen (dad_admin, psql, respaldos).
# PG_MAX_CONNECTIONS=60
# PG_SHM_SIZE=256mb
# Consultas más lentas que esto quedan en el log de PostgreSQL (ms; -1 desactiva).
# PG_LOG_CONSULTAS_LENTAS_MS=500
# Pools de conexiones (compartidos por todas las copropiedades).
# API_DB_CONEXIONES=30
# GATEWAY_DB_CONEXIONES=15
# Límites de memoria por contenedor (que HestiaCP y la aplicación no se quiten RAM).
# LIMITE_MEMORIA_POSTGRES=1536m
# LIMITE_MEMORIA_API=512m
# LIMITE_MEMORIA_GATEWAY=512m
# Puertos locales (cambiarlos solo para un entorno de prueba en el mismo VPS).
# API_PUERTO=8080
# GATEWAY_PUERTO=8081

# --- Prueba de carga (dad_carga; solo contra un entorno de prueba, ver docs/despliegue.md §9) ---
# Contraseña de las cuentas de administrador que crea la siembra (mínimo 10 caracteres).
# CARGA_CONTRASENA=
# Superusuario del entorno de prueba (dad_admin crear-superusuario) y, si ya activó el segundo
# factor, su secreto TOTP en Base32 (la siembra lo muestra la primera vez que lo activa).
# CARGA_ROOT_USUARIO=
# CARGA_ROOT_CONTRASENA=
# CARGA_ROOT_TOTP=
